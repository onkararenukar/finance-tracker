<?xml version="1.0" encoding="UTF-8"?>
<!--
    parsing-service/pom.xml

    RESPONSIBILITY OF THIS SERVICE:
    Consume `statement.ingested` events from Kafka, send each extracted
    text chunk to an LLM to be turned into structured transaction records
    (date, description, amount, direction), persist those transactions in
    Postgres, compute a vector embedding for each transaction's
    description and store it via pgvector (so the analytics-service can
    later do semantic/RAG-style retrieval over transaction history), and
    publish one `transaction.parsed` event per persisted transaction for
    the (future) categorization-service to pick up.

    This service has NO public REST API for business use (it's a pure
    Kafka consumer/producer) - spring-boot-starter-web is included only
    so Actuator's /actuator/health endpoint exists for Docker healthchecks.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.financetracker</groupId>
        <artifactId>finance-tracker-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>parsing-service</artifactId>
    <packaging>jar</packaging>
    <name>Finance Tracker - Parsing Service</name>

    <dependencies>
        <!-- Actuator health endpoint only - see class javadoc above -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Swagger/OpenAPI documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Kafka consumer (statement.ingested) + producer (transaction.parsed) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
<!--            <scope>runtime</scope>-->
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- pgvector JDBC support - registers the `vector` PG type and lets us
             bind float[] embeddings via PGvector objects in plain JDBC/JdbcTemplate
             calls (see TransactionEmbeddingStore for why we don't go through JPA
             for this one column). -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>${pgvector.version}</version>
        </dependency>

        <!-- Spring's modern HTTP client, used to call the LLM (chat + embeddings)
             API - whether that's a local model server or a hosted provider. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============ TEST ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>parsing-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- release / enable-preview inherited from parent pluginManagement.
                     enable-preview is REQUIRED (not just nice-to-have) in this
                     module specifically, because TransactionParsingService uses
                     java.util.concurrent.StructuredTaskScope (JEP 499, 4th preview
                     in JDK 24) to fan out per-chunk LLM calls concurrently. -->
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <!-- argLine (enable-preview) inherited from parent pluginManagement.
                     Must be explicitly declared here, same as maven-compiler-plugin above,
                     or the parent's pluginManagement config for it is never applied. -->
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
